# Balaji Connect Environment Configuration

# Django Core
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2,connect.balajitransports.com
CSRF_TRUSTED_ORIGINS=https://connect.balajitransports.com,http://127.0.0.1:8000,http://127.0.0.1:8001

# Redis Channels Layer (Optional: for multi-worker production WebSockets)
# REDIS_URL=redis://127.0.0.1:6379/0

# Database: Supports MySQL and PostgreSQL
# Option 1: MySQL (Recommended for local server deployment)
DB_ENGINE=mysql
DB_NAME=balaji_connect
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Option 2: PostgreSQL (Alternative)
# DB_ENGINE=postgresql
# DB_NAME=balaji_connect
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password_here
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Option 3: Full Connection URL (PostgreSQL or MySQL)
# DATABASE_URL=mysql://root:<your_password>@127.0.0.1:3306/balaji_connect
# DATABASE_URL=postgres://postgres:<your_password>@127.0.0.1:5432/balaji_connect

# Media Storage Driver: 'local' (development/testing) or 'gdrive' (production Google Drive)
STORAGE_DRIVER=local

# Local Storage Directory (Used when STORAGE_DRIVER=local)
LOCAL_STORAGE_DIR=media_vault_storage

# Google Drive OAuth 2.0 Configuration (Used when STORAGE_DRIVER=gdrive)
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id_here
GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret_here
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_drive_refresh_token_here
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Rate Limiting
LOGIN_RATE_LIMIT=10/m
